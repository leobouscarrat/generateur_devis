    "ProfilPliage": {
      "additionalProperties": false,
      "description": "Profil de la pièce vu de côté, pour des plis parallèles.\n\nSéquence alternée aile → pli → aile → … qui commence et finit par une aile.\nExemple d'un Z : aile 18 → pli 90° haut → aile 22 → pli 90° bas → aile 42.\nUne pièce plate a une seule aile.",
      "properties": {
        "confiance": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Confiance dans la lecture, de 0 (aucune) à 1 (certaine).",
          "title": "Confiance"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Endroit du plan où l'élément a été lu."
        },
        "cotation": {
          "default": "inconnue",
          "description": "Les longueurs d'ailes sont-elles cotées à l'extérieur ou à l'intérieur ?",
          "enum": [
            "exterieure",
            "interieure",
            "inconnue"
          ],
          "title": "Cotation",
          "type": "string"
        },
        "elements": {
          "description": "Ailes et plis, en alternance, de gauche à droite sur la vue de côté.",
          "items": {
            "discriminator": {
              "mapping": {
                "aile": "#/$defs/Aile",
                "pli": "#/$defs/Pli"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Aile"
              },
              {
                "$ref": "#/$defs/Pli"
              }
            ]
          },
          "title": "Elements",
          "type": "array"
        },
        "rayon_pliage_general": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rayon de pliage donné par une note générale (ex. « BENDING RADIUS 2mm »).",
          "title": "Rayon Pliage General"
        }
      },
      "required": [
        "elements"
      ],
      "title": "ProfilPliage",
      "type": "object"
    },
